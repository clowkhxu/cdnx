แต่ก็เป็นไปไม่ได้ที่จะล่วงรู้
ความเป็นมาและที่พักของข้ากับรองเจ้ากรม

22:39.840 --> 22:41.320
แล้วมาสลับกำยานของพวกเราไปด้วย

22:41.960 --> 22:44.000
ท่านรู้ว่าตัวเองได้เผยพิรุธแล้ว

22:44.080 --> 22:45.920
จะถูกจับก็เป็นเรื่องไม่เร็วก็ช้า

22:46.000 --> 22:47.640
แล้วเหตุใดต้องหวนกลับไปเรือนสกุลอู่

22:47.720 --> 22:48.840
เดินเข้ามาติดกับเองด้วย

22:49.440 --> 22:51.160
ท่านอยากใช้ชีวิตของตัวเอง

22:51.240 --> 22:52.840
เดิมพันโอกาสรอดชีวิตให้กับคนคนนั้น

22:57.400 --> 22:58.480
พูดมา

22:58.560 --> 22:59.600
ผู้สมรู้ร่วมคิดของเจ้าคือใคร

23:00.240 --> 23:01.680
ข้าไม่มีคนสมรู้ร่วมคิด

23:04.200 --> 23:05.240
จะไม่พูดใช่หรือไม่

23:09.120 --> 23:10.840
ท่านหญิง บางที

23:10.920 --> 23:14.320
ใช้บทลงโทษแค่เพียงเล็กน้อย

23:14.400 --> 23:15.520
เขาก็อาจจะสารภาพออกมา

23:15.600 --> 23:17.640
เขาไม่กลัวแม้แต่ความตาย

23:17.720 --> 23:19.160
จะไปกลัวการทรมานได้อย่างไร

23:19.800 --> 23:21.280
อีกอย่างแค่เรื่องเล็กน้อยเท่านี้

23:21.360 --> 23:22.480
มีตรงไหนสืบยากด้วย

23:24.840 --> 23:26.040
ข้าเข้าใจแล้ว

23:26.960 --> 23:28.560
ผู้สมรู้ร่วมคิดของเขา

23:28.640 --> 23:30.680
ก็อยู่ในจวนของอู่ซือผิง

23:38.040 --> 23:38.880
มู่จิน

23:39.520 --> 23:40.560
ข้าเป็นคนทำเอง

23:41.080 --> 23:42.480
เจ้ามาทำไมน่ะ

23:42.560 --> 23:43.640
เขามายอมรับผิด

23:43.720 --> 23:45.040
เด็กตัวเล็กแค่นี้

23:45.120 --> 23:46.080
เขาจะมีความผิดอะไรได้

23:46.680 --> 23:48.920
เขาก็คือไส้ศึกข้างในของเหล่าเซียว

23:49.000 --> 23:50.040
ไม่ใช่ ไม่ใช่เขา

23:50.120 --> 23:51.080
ฮูหยินอู่

23:51.160 --> 23:53.480
อู่มู่จินได้รับความทุกข์ทรมานแสนสาหัส

23:53.560 --> 23:54.400
ถูกคนร้ายยุยงส่งเสริม

23:55.000 --> 23:56.680
ถึงได้สับเปลี่ยนกำยานนำทางให้คน

23:56.760 --> 23:58.320
เขาอายุยังน้อย

23:58.400 --> 23:59.920
ไม่มีความสามารถในการแยกแยะถูกผิด

24:00.000 --> 24:01.200
ต้องมีคน

24:01.280 --> 24:03.280
ใส่ใจดูแลและอบรมสั่งสอน

24:03.360 --> 24:04.960
ไม่อย่างนั้นเส้นทางของเขาในวันหน้า

24:05.040 --> 24:06.120
ก็จะเดินได้ยากลำบาก

24:08.080 --> 24:09.400
ฮูหยินอู่คิดเห็นประการใด

24:19.240 --> 24:20.280
ข้าสำนึกผิดแล้ว

24:20.360 --> 24:21.400
ขอนายอำเภอโปรดลงโทษ

24:22.520 --> 24:23.360
ไม่นะ

24:26.480 --> 24:28.360
ท่านหญิงคิดเห็นประการใด

24:29.080 --> 24:30.840
ท่านหญิง ท่านหญิง

24:30.920 --> 24:33.520
เรื่องนี้ไม่เกี่ยวข้องกับเด็ก

24:33.600 --> 24:35.680
ท่านหญิงโปรดพิจารณาอย่างถี่ถ้วน

24:39.240 --> 24:40.120
เอาตามนายอำเภอว่า

24:46.040 --> 24:47.120
อู่มู่จิน

24:47.720 --> 24:49.560
เห็นแก่ที่เจ้าอายุยังน้อย

24:49.640 --> 24:51.320
แถมยังถูกคนยุยงส่งเสริม

24:53.560 --> 24:55.320
ไม่มีตรงส่วนไหนให้ต้องตำหนิลงโทษ

24:55.960 --> 24:57.080
ฮูหยินอู่

24:57.680 --> 25:00.000
รบกวนท่านพาเขากลับไป

25:00.600 --> 25:01.760
ตั้งใจอบรมสั่งสอนเขาให้ดี

25:01.840 --> 25:03.360
ขอบคุณนายอำเภอ

25:03.440 --> 25:04.960
ขอบคุณนายท่านหญิง

25:08.520 --> 25:09.640
ท่านหญิง

25:10.680 --> 25:12.160
งั้นอู่ซือผิง

25:12.240 --> 25:14.200
ถึงอย่างไรก็เป็นญาติสายรองของตระกูลอู่

25:14.280 --> 25:15.560
คดีนี้

25:15.640 --> 25:18.600
มีกองสืบสวนกับศาลต้าหลี่ร่วมกันคลี่คลายคดี

25:19.200 --> 25:20.800
ขอท่านหญิง

25:20.880 --> 25:23.800
นำตัวคนร้ายหลักกลับไปยังซีจิงได้หรือไม่

25:23.880 --> 25:26.400
ข้าน้อย… ข้าน้อยคือ…

25:26.480 --> 25:27.640
เช่นนี้

25:28.160 --> 25:29.800
ก็ให้ผู้ตรวจการกู้กับอู่เหริน

25:29.880 --> 25:31.080
นำตัวเขากลับไปซีจิงเถอะ

25:32.600 --> 25:34.080
ขอบคุณท่านหญิง

25:34.160 --> 25:35.960
ขอบคุณท่านผู้ตรวจการ

25:52.360 --> 25:53.760
เรื่องของเสียวหว่าน

25:53.840 --> 25:55.280
ข้าบอกเหล่าเซียวเอง

25:55.360 --> 25:57.200
แต่คนที่อยากช่วยอู่มู่จินคือท่าน

25:57.720 --> 25:59.680
คนที่ให้เหล่าเซียวกับเด็กยอมรับนับถือกัน

25:59.760 --> 26:00.640
ก็เป็นท่านด้วยเหมือนกัน

26:03.440 --> 26:04.720
อี้เอิน

26:04.800 --> 26:06.040
ออกไปเล่นข้างนอกเถอะ

26:06.760 --> 26:07.760
อี้เอินหรือ

26:08.600 --> 26:09.560
ท่านแม่บอกแล้ว

26:09.640 --> 26:11.400
นับจากนี้ไปข้าชื่อเซียวอี้เอิน

26:22.600 --> 26:24.720
ข้าหาได้จะแก้ต่างให้ตัวเอง

26:25.920 --> 26:27.600
แต่การตายของอู่ซือผิง

26:27.680 --> 26:30.000
เป็นกฎแห่งกรรมอย่างแท้จริง

26:30.080 --> 26:32.360
เป็นตัวเขาเองที่ก่อกรรมชั่วด้วยมือของตัวเอง

26:32.960 --> 26:35.000
ก่อนอู่ซือผิงจะไปจากซีจิง

26:35.080 --> 26:37.960
ฝ่าบาทโรคเก่ากำเริบ ทุกข์ทรมานแสนสาหัส

26:38.040 --> 26:40.840
หมอชื่อดังทั่วทั้งซีจิงล้วนแล้วแต่จนปัญญา

26:40.920 --> 26:43.640
เซี่ยเหม่ยเหรินมีพระประสูติกาลองค์ชายพอดี

26:44.160 --> 26:46.440
โรคเก่าของฝ่าบาทกลับหายเอง
ทั้งๆ ที่ไม่ได้รักษา

26:48.000 --> 26:49.160
กรมโหราศาสตร์พบว่า

26:49.240 --> 26:50.600
องค์ชายน้อย

26:50.680 --> 26:53.600
มีแปดอักษรสมพงศ์กับฝ่าบาท ขจัดโรคร้ายหมดสิ้น

26:54.200 --> 26:55.800
ฝ่าบาททรงยินดีพระทัย

26:55.880 --> 26:58.360
ตรัสว่าเซี่ยเหม่ยเหรินตั้งครรภ์ดี

26:58.440 --> 27:00.320
องค์ชายน้อยเพิ่มพูนโชควาสนาให้พระองค์

27:00.400 --> 27:02.160
ทรงพระราชทานปูนบำเหน็จให้เซี่ยเหม่ยเหริน

27:02.240 --> 27:03.440
กับองค์ชายน้อยอย่างมหาศาล

27:06.800 --> 27:10.120
อู่ซือผิงมักจะเกิดผื่นแดงตามผิวหนังบ่อยครั้ง

27:10.200 --> 27:12.240
เที่ยวเสาะหาหมอและยารักษาไม่เห็นจะดีขึ้น

27:12.320 --> 27:14.120
เขาลาออกจากตำแหน่งมายังที่นี่

27:14.720 --> 27:17.200
ก็อยากจะเอาอย่างฝ่าบาท เพิ่มพูนโชควาสนา

27:17.960 --> 27:20.040
ถึงได้เกิดเรื่องราวตามมามากมาย

27:21.160 --> 27:22.680
แต่โรคเรื้อรังของเขา

27:22.760 --> 27:25.760
ได้หายดีไปพร้อมกับการเกิดมาของอี้เอินจริงๆ

27:28.800 --> 27:30.800
เห็นท่าเรื่องนี้
กรมโหราศาสตร์ก็มีส่วนรับผิดชอบเช่นกัน

27:31.800 --> 27:33.360
พระอาการประชวรของฝ่าบาทดีขึ้น

27:33.440 --> 27:35.800
เป็นผลลัพธ์ที่สำนักหมอหลวง
ตั้งใจปรับสมดุลมาอยู่หลายปี

27:35.880 --> 27:37.600
อู่ซือผิงหายจากอาการผื่นแดง

27:37.680 --> 27:40.000
มีความเกี่ยวข้อง
กับสภาพอากาศประจำถิ่นเป็นอย่างมาก

27:40.080 --> 27:41.200
ที่เรียกว่าเพิ่มพูนโชควาสนา

27:41.280 --> 27:42.720
แท้จริงแล้วเป็นแค่เรื่องเหลวไหล

27:43.320 --> 27:44.440
ข้ายังยืนยันคำเดิม

27:44.520 --> 27:46.600
ปัญจธาตุปรากฏการณ์ดวงดาว
ต่างมีกฎของตัวมันเอง

27:46.680 --> 27:48.000
สิ่งที่สร้างปัญหาก่อความวุ่นวาย

27:48.080 --> 27:49.440
ทำเรื่องเล็กให้กลายเป็นเรื่องใหญ่

27:49.520 --> 27:50.520
มีเพียงมนุษย์เท่านั้น

27:56.040 --> 27:58.280
เมื่อก่อนท่านลุงไม่ใช่คนงมงาย

27:58.920 --> 28:01.040
บัดนี้ทำร้ายผู้บริสุทธิ์ให้ต้องบ้านแตกสาแหรกขาด

28:01.120 --> 28:03.200
เด็กน้อยไร้ที่พึ่งพิง

28:03.280 --> 28:04.840
เพราะผลประโยชน์ของตัวเอง

28:05.520 --> 28:08.160
และเด็กคนนี้
ยังเป็นเลือดเนื้อเชื้อไขแท้ๆ ของเขา

28:09.560 --> 28:11.360
บางคนเพื่อความมั่งคั่งรุ่งเรือง

28:11.880 --> 28:14.040
ถึงกับทำร้ายเลือดเนื้อเชื้อไขของตัวเองได้ลงคอ

28:15.040 --> 28:16.760
บางคนเห็นแก่ความผูกพันในสายเลือด

28:17.360 --> 28:19.160
ทนแบกรับความอัปยศเพื่อล้างแค้น

28:19.240 --> 28:20.640
อดทนต่อความลำบากเพื่อรอคอยเวลาได้

28:22.000 --> 28:24.000
แต่ก็มีบางคนเพราะความดีงามที่อยู่ในใจ

28:24.720 --> 28:26.360
ต่อให้ไม่ได้เป็นญาติกันทางสายเลือด

28:26.440 --> 28:27.720
ก็กล้าออกมาเผชิญหน้าต่อสู้แทนให้ได้

28:29.680 --> 28:32.200
เป็นมาร หรือเป็นพระ

28:32.280 --> 28:34.080
แค่เพียงชั่วขณะที่ใจคิดจะรุกหรือถอย

28:35.800 --> 28:36.720
ท่านหญิง

28:37.440 --> 28:39.080
ผีเสื้อน้อยตัวนี้ปีกหลุดไปข้างหนึ่ง

28:39.160 --> 28:40.360
มันบินไม่ได้แล้ว

28:45.600 --> 28:46.760
แต่มันยังมีชีวิตอยู่

28:47.280 --> 28:49.120
ขอแค่มีชีวิตอยู่ก็ยังมีความหวัง

28:49.800 --> 28:50.720
เจ้าช่วยมันแล้ว

28:50.800 --> 28:53.240
เจ้าจะดูแลมันให้ดีๆ ใช่หรือไม่

28:54.280 --> 28:55.360
มันบินไม่ได้แล้ว

28:55.440 --> 28:56.960
แต่ข้าจะทำให้มันมีชีวิตต่อไปให้ดีๆ

29:00.720 --> 29:02.120
ข้าจะไปหากล่องกระเบื้องให้เจ้า

29:02.200 --> 29:03.640
ทำเป็นบ้านของมัน ดีหรือไม่

29:11.920 --> 29:13.160
มือของเจ้าเป็นอะไรไป

29:14.000 --> 29:16.040
บาดเจ็บตอนเมื่อครู่ที่ช่วยผีเสื้อน้อย

29:20.480 --> 29:22.040
ข้าไม่เป็นไร ข้าไม่เจ็บ

29:22.640 --> 29:24.680
บาดแผลน่ะ ต้องจัดการดูแลในทันที

29:24.760 --> 29:26.040
ถึงจะหายได้ในเร็ววัน

29:35.240 --> 29:36.440
หากไม่สนใจ

29:36.520 --> 29:38.280
ก็จะกลายเป็นรอยแผลเป็นตลอดไป

29:46.120 --> 29:51.600
(แบกรับโลกหล้าคือคุณธรรมสูงส่ง)

29:51.680 --> 29:52.760
ท่านหญิง

29:55.320 --> 29:57.000
ท่านหญิงรอข้าอยู่หรือ

29:57.600 --> 29:58.440
ใช่

29:58.960 --> 30:00.400
มีเรื่องบางเรื่องอยากถามฮูหยิน

30:01.400 --> 30:03.400
ท่านหญิงเป็นผู้มีพระคุณช่วยชีวิตข้าไว้

30:03.480 --> 30:05.640
มีอะไรท่านพูดมาได้เลย

30:06.800 --> 30:08.800
เหตุใดตอนนั้นอู่ซือผิงถึงไปจากเมืองหลวง

30:08.880 --> 30:12.360
ตอนนั้นเขาลาออกจากราชการเพราะอาการป่วย

30:12.440 --> 30:14.400
แต่ข้ารู้ นี่ไม่ใช่ความตั้งใจของเขา

30:14.480 --> 30:16.720
ตอนนั้นเขาเป็นผู้บัญชาการ
องครักษ์ฝ่ายซ้ายของรัชทายาท

30:16.800 --> 30:18.200
หรือว่าเป็นความประสงค์ของรัชทายาท

30:18.920 --> 30:20.040
ไม่มีทางเจ้าค่ะ

30:20.120 --> 30:22.600
รัชทายาททรงกริ้วหนักมากที่จู่ๆ เขาขอลาป่วย

30:22.680 --> 30:24.160
แต่เขายังยืนกรานจะไป

30:25.120 --> 30:26.920
คืนเทศกาลโคมไฟเมื่อ 15 ปีก่อน

30:27.000 --> 30:29.480
ตอนที่บ้านข้าเกิดคดีน่าสลด เขาอยู่ที่ไหน

30:34.440 --> 30:35.440
เขาไปจวนอ๋องตวนหรือไม่

30:36.600 --> 30:37.720
ไม่เจ้าค่ะ

30:39.280 --> 30:42.040
คืนนั้นไม่ควรจะเป็นเขาที่เข้าเวร

30:42.560 --> 30:43.400
แต่…

30:45.800 --> 30:47.120
(จวนสกุลอู่)

30:55.600 --> 30:57.720
พาตัวคนมาทันที ตามข้าไปจวนอ๋องตวน

30:57.800 --> 30:59.400
- ตอนนี้หรือ
- ใช่

30:59.480 --> 31:00.600
รัชทายาททรงทราบเรื่องแล้วหรือ

31:01.200 --> 31:02.640
ทางรัชทายาทข้าจะรายงานเอง

31:03.360 --> 31:04.440
นี่…

31:04.960 --> 31:05.840
ไม่เป็นไปตามกฎใช่หรือไม่

31:06.960 --> 31:09.000
หากท่านไม่ไป
ก็เอาป้ายคำสั่งทหารในจวนมาให้ข้า

31:09.080 --> 31:11.200
ข้าจะบอกว่าข้าบังคับขอมาเอง

31:11.280 --> 31:12.360
ไม่มีทางทำท่านเดือดร้อนแน่

31:15.280 --> 31:16.480
เร็วเข้า

31:21.640 --> 31:25.440
ราชครู นี่เพราะเรื่องอันใดกัน

31:28.200 --> 31:30.600
ท่านยิ่งรู้น้อยยิ่งปลอดภัย

31:44.840 --> 31:47.040
หลังจากคืนวันนั้นไม่นานเท่าไร

31:47.120 --> 31:49.440
อู่ซือผิงก็แจ้งว่าป่วยแล้วไปจากเมืองหลวง

31:49.520 --> 31:52.800
สำหรับคืนวันนั้นเกิดเรื่องอะไรขึ้นกันแน่

31:52.880 --> 31:54.400
เขาไม่เคยพูดถึงอีกเลย

31:55.880 --> 31:57.720
ท่านแน่ใจหรือไม่ว่าคืนนั้นคนที่เอาตราทหารไป

31:57.800 --> 31:58.840
คือเซียวเหวินยวน

31:59.360 --> 32:00.880
เขาบอกว่าจะเอาตราทหารไปจวนอ๋องตวน

32:00.960 --> 32:02.080
เจ้าค่ะ

32:02.600 --> 32:04.520
ข้าได้ยินได้เห็นอย่างชัดเจน

32:06.960 --> 32:08.280
ฮูหยินยังจำได้หรือไม่

32:08.360 --> 32:09.520
ว่าเซียวเหวินยวนมายามใด

32:10.880 --> 32:13.320
สำหรับว่าเป็นยามใด

32:13.400 --> 32:15.040
ข้าจำไม่ได้แล้วจริงๆ

32:15.120 --> 32:16.200
แต่…

32:16.720 --> 32:18.520
จะต้องเป็นก่อนยามจื่อแน่นอน

32:19.800 --> 32:20.880
ก่อนยามจื่อ

32:24.120 --> 32:25.640
ก่อนยามจื่อ

32:27.280 --> 32:28.280
ท่านหญิง

32:30.680 --> 32:32.080
ไป

32:41.560 --> 32:43.000
ใครก็ได้

32:45.240 --> 32:46.760
ใครก็ได้

32:46.840 --> 32:47.920
ใครก็ได้

33:00.400 --> 33:01.240
ฮูหยิน

33:04.080 --> 33:06.200
ป้องกันท่านหญิงกับฮูหยิน ไป

33:40.520 --> 33:41.240
ระวัง

33:52.680 --> 33:53.840
อู่เลี่ย พาตัวฮูหยินไป

33:53.920 --> 33:54.920
พวกเขาเจาะจงเล่นงานข้า

33:55.520 --> 33:57.000
จะทิ้งท่านหญิงไว้คนเดียวไม่ได้

33:57.080 --> 33:58.320
ท่านเป็นแม่คน

33:58.400 --> 33:59.600
ตายกับข้าอยู่ที่นี่จะไม่ยุติธรรมเกินไป

33:59.680 --> 34:00.680
ไป

34:16.800 --> 34:18.199
พาคนมาตั้งเยอะขนาดนี้

34:18.280 --> 34:19.199
ดูท่าคงกลัวแล้วจริงๆ

34:19.280 --> 34:21.120
ท่านหญิงเฉลียวฉลาดเหนือผู้คน

34:21.199 --> 34:22.800
ย่อมเข้าใจ

34:22.880 --> 34:25.520
ยิ่งรู้มากก็ยิ่งอันตราย

34:25.600 --> 34:27.800
แต่ทางที่ดี เจ้าจะต้องฆ่าข้าได้จริงๆ

34:28.520 --> 34:30.560
ไม่งั้นเจ้าและคนที่อยู่เบื้องหลัง

34:30.639 --> 34:31.760
ต้องเคราะห์ร้ายกันหมดแน่

34:31.840 --> 34:32.719
ฆ่านาง

35:02.120 --> 35:03.720
ยังมีความสามารถอย่างอื่นอีกหรือไม่

35:07.040 --> 35:08.200
ถ้าไม่มี

35:09.320 --> 35:10.400
ข้าก็จะฆ่าเจ้า

35:11.040 --> 35:12.480
ฆ่าเจ้าไม่ได้

35:12.560 --> 35:14.640
พวกเราก็ไม่อาจมีชีวิตกลับไปได้

35:16.000 --> 35:17.440
ข้าก็ไม่ได้มาตัวคนเดียว

35:18.040 --> 35:19.480
ท่านหญิงไม่ต้องมาหลอกข้า

35:20.120 --> 35:23.160
กู้หลิงโจวกับอู่เหรินกำลังเดินทางไปซีจิง

35:23.240 --> 35:25.640
รอบตัวเจ้าเหลือแค่เซียวหวยจิ่นเพียงคนเดียว

35:27.160 --> 35:29.320
เขาจะไปช่วยอะไรเจ้าได้

35:30.560 --> 35:31.720
ฆ่านาง

35:32.480 --> 35:33.400
ฆ่า

35:40.720 --> 35:41.640
ท่านมาทำอะไร

35:41.720 --> 35:42.880
ฮูหยินอู่บอกว่าท่านตกอยู่ในอันตราย

35:53.400 --> 35:54.400
ท่านหญิง

35:56.280 --> 35:57.200
ข้าประมาทเกินไป

35:58.080 --> 35:59.120
ลูกธนูมียาพิษ

36:00.560 --> 36:01.640
ท่านรีบไป ไม่ต้องสนใจข้า

36:06.600 --> 36:09.000
ตอนนี้ไม่ใช่เวลามาแสดง
ทำว่ามีน้ำใจไมตรีหนักแน่น

36:09.080 --> 36:10.120
ท่านจะตายเอาได้

36:10.200 --> 36:11.040
ไม่เป็นไร

36:11.120 --> 36:13.280
เดิมทีโลกใบนี้
ก็ไม่มีเรื่องที่ต้องเป็นข้าเท่านั้นถึงทำได้อยู่แล้ว

36:13.360 --> 36:15.000
แต่ท่าน ข้าต้องช่วยให้ได้

36:15.080 --> 36:16.320
ข้าเจ็บแผล

36:23.160 --> 36:24.080
อยากจะตีข้าให้สลบ

36:24.160 --> 36:26.120
แล้วตัวเองก็ไปรนหาที่ตาย ไม่มีทางเสียหรอก

36:26.720 --> 36:28.280
พวกเราหนีออกไปด้วยกัน

36:28.360 --> 36:29.520
หรือไม่ข้าก็อยู่รอความตายกับท่าน

36:30.120 --> 36:32.120
- ข้าไม่ซาบซึ้งหรอกนะ
- หากข้าอยากให้ท่านซาบซึ้ง

36:32.720 --> 36:34.160
ก็ไม่มีทางเลือกอยู่เคียงข้างท่านหรอก

36:37.800 --> 36:39.080
อย่างนั้นรองเจ้ากรม

36:40.120 --> 36:41.440
เรามาพยายามมีชีวิตต่อไปกันเถอะ

36:44.480 --> 36:45.600
เจ้าเด็กบ้า

36:47.920 --> 36:49.520
ห่างจากคนแก่อย่างข้า

36:49.600 --> 36:51.480
โดนทำร้ายซะน่าสังเวชขนาดนี้เลยหรือ

36:52.000 --> 36:53.000
ผีแก่

36:53.520 --> 36:54.800
ท่านมาได้อย่างไร

36:54.880 --> 36:56.240
ขืนข้ายังไม่มา

36:56.320 --> 36:59.640
ก็ต้องเก็บศพเจ้าแทนแล้วน่ะสิ

37:15.640 --> 37:17.240
ไอ้ผีเปรตพวกนี้

37:17.320 --> 37:19.400
ดูท่าอยากจะได้ชีวิตของเจ้าจริงๆ

37:20.160 --> 37:22.960
- พิษนี้แก้ได้หรือไม่
- กินยาของข้า ไม่ตายง่ายๆ หรอก

37:23.040 --> 37:25.160
แต่ความทรมานที่ยังไม่ตายคงหนีไม่พ้น

37:25.240 --> 37:26.400
หมายความว่าอย่างไร

37:28.520 --> 37:29.720
เพ่ยอี๋

37:30.320 --> 37:31.320
ท่านหญิง

37:31.400 --> 37:33.160
- เน่ยซื่อป๋อ
- ไม่เป็นไร

37:34.120 --> 37:35.400
อาเจียนออกมาได้ก็ดีแล้ว

37:37.680 --> 37:38.720
ผีแก่

37:39.480 --> 37:41.080
ท่านรู้ได้อย่างไรว่าเกิดเรื่องกับข้า

37:41.680 --> 37:42.600
เจ้าน่ะ

37:42.680 --> 37:44.120
สิ่งที่สั่งสอนเจ้า

37:44.200 --> 37:45.880
ไม่เคยจดจำใส่ใจบ้างเลย

37:45.960 --> 37:47.240
เดินอ้อมทางในหมิงโจว

37:47.320 --> 37:49.000
ไม่รู้จักกลบซ่อนร่องรอย

37:49.080 --> 37:51.960
แม้แต่ข้ายังได้ยิน พวกเขาจะไม่รู้ได้หรือ

37:52.040 --> 37:53.680
ต่อให้ต้องตามสืบ

37:53.760 --> 37:55.440
นั่นก็ต้องเป็นความเคลื่อนไหวที่รวดเร็วมาก

37:55.520 --> 37:56.440
เสียเวลามาตั้งนาน

37:56.520 --> 37:58.720
ก็เท่ากับให้เวลาคนมาฆ่าเจ้าไม่ใช่หรือ

38:00.440 --> 38:02.560
ท่านเดินทางมาไกลจากซีจิง

38:03.360 --> 38:04.640
ก็เพื่อมาด่าข้าน่ะหรือ

38:04.720 --> 38:06.360
เจ้าน่ะ ควรให้โดนด่าแล้ว

38:13.400 --> 38:14.440
เอาละ

38:14.520 --> 38:15.640
ตรงนี้ให้เป็นหน้าที่ของข้า

38:15.720 --> 38:17.280
ท่านหญิง

38:17.360 --> 38:18.960
ขอฝากไว้กับท่านด้วย

38:23.840 --> 38:24.920
พวกเขามีพวกมาก

38:25.440 --> 38:26.560
เกรงว่าจะรับมือยาก

38:26.640 --> 38:29.000
ดังนั้นถึงต้องให้ข้ามาจัดการอย่างไรเล่า

38:30.560 --> 38:31.520
ไปเถอะ

38:36.120 --> 38:37.520
เด็กบ้า

38:37.600 --> 38:39.920
ต่อไปใช้ชีวิตให้ละเอียดรอบคอบหน่อย

38:40.000 --> 38:42.440
อย่าได้สร้างความยุ่งยากให้ข้าอีก

38:44.400 --> 38:45.640
ข้ารับปากท่าน

38:47.160 --> 38:48.480
ไปให้พ้น

38:48.560 --> 38:49.600
ถนอมตัวด้วย

39:19.480 --> 39:20.720
เจ้า

39:20.800 --> 39:22.280
รู้จักหรือ

39:23.280 --> 39:24.800
ดูท่าเป็นสหายเก่าสินะ

39:25.560 --> 39:27.240
เจ้าไม่ขวางข้า

39:27.320 --> 39:28.680
ก็ไม่จำเป็นต้องตาย

39:29.280 --> 39:31.040
ในเมื่อรู้ว่าข้าคือใคร

39:31.720 --> 39:33.080
ก็ไม่ต้องมาพล่ามไร้สาระ

39:33.160 --> 39:34.960
- มาเถอะ
- ฆ่ามัน

39:58.080 --> 40:00.680
ไม่ได้ฝึกซ้อมมานานแล้ว

40:00.760 --> 40:01.520
สะใจยิ่งนัก

42:02.680 --> 42:03.720
ไอ้แก่

42:04.440 --> 42:05.400
ใช้อุบายกับข้า

42:06.000 --> 42:07.080
ไม่ทำเช่นนี้

42:07.160 --> 42:10.360
จะไปรู้ได้อย่างไรว่าเจ้าเป็นสหายเก่าคนไหน

42:34.520 --> 42:35.680
เลวทรามอย่างที่คิด

42:37.360 --> 42:38.440
ยังไม่พอ

42:54.640 --> 42:56.480
- ดาบนั่นมีพิษ
- ท่านไปไม่ได้

42:56.560 --> 42:58.000
ถ้าเน่ยซื่อป๋อไม่อาจรอดพ้นได้

42:58.080 --> 43:00.000
ท่านไปก็มีแต่ตายไปด้วยกัน

43:00.080 --> 43:01.240
ข้ายอมตายไปด้วยกัน

43:01.320 --> 43:02.400
ท่านรับปากเขาแล้ว

43:02.480 --> 43:04.000
ท่านต้องมีชีวิตต่อไปให้ดีๆ

43:06.560 --> 43:07.800
มีชีวิตอยู่ช่างยากเย็น

43:09.440 --> 43:10.280
ตายไปกลับง่ายกว่า

43:26.360 --> 43:27.520
ขอโทษด้วย

43:27.600 --> 43:29.240
ข้าจำเป็นต้องทำให้ท่านมีชีวิตต่อไปให้ดี
