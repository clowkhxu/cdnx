25:11.440 --> 25:12.200
[lucu,]

25:13.640 --> 25:14.520
[pendiam,]

25:16.200 --> 25:17.040
[biasa saja,]

25:19.080 --> 25:21.640
[serta teguh.]

25:25.960 --> 25:27.290
[Ada yang mengatakan,]

25:27.640 --> 25:30.440
[manusia hanya hidup
dalam beberapa momen saja.]

25:30.600 --> 25:31.730
[Aku tidak setuju.]

25:32.880 --> 25:34.080
[Karena semua momen]

25:34.680 --> 25:36.680
[yang aku ketahui tentang dirinya]

25:36.960 --> 25:38.420
